{
  "name": "makebot-gui",
  "version": "1.1.1",
  "description": "MakeBot+ Console",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --arm64",
    "build:dir": "electron-builder --win --x64 --dir",
    "release": "electron-builder --win --x64 --publish always",
    "release:mac": "electron-builder --mac --arm64 --publish always"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.1.0",
    "unzipper": "^0.12.5",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.makebot.console",
    "productName": "MakeBot+",
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "jiggysosa123",
      "repo": "make-gui"
    },
    "extraResources": [
      {
        "from": "engine/",
        "to": "engine/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "public/**/*"
    ]
  }
}
